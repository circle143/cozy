	page="gallery"
	description="Birthday parties, celebrations, live music nights and corporate events at Cozy - The Casual Lounge, Sector 75, Noida."
>
	<Hero title="Gallery" />

	<Categories page="events" />

	<Gallery images={eventsImages} />
</Layout>
